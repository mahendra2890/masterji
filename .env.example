# --- frontend (.env.local) --------------------------------------------------
# Server-side proxy target for /api/* rewrites. Local Django default:
API_URL=http://127.0.0.1:8000

# --- backend (backend/.env) -------------------------------------------------
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=            # required when DJANGO_DEBUG=0
# DATABASE_URL=                 # unset → local SQLite
# GOOGLE_CLIENT_ID=             # unset → Google login disabled (use dev-login)
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:3000
# LLM_MODEL=openai/gpt-5.4-mini
# OPENAI_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=  # unset → tracing off
# OTEL_EXPORTER_OTLP_API_KEY=
