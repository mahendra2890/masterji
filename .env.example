# --- frontend (.env.local) --------------------------------------------------
# Server-side proxy target for /api/* rewrites. Local Django default:
API_URL=http://127.0.0.1:8000

# --- backend (backend/.env) -------------------------------------------------
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=            # required when DJANGO_DEBUG=0
# DATABASE_URL=                 # unset → local SQLite
# GOOGLE_CLIENT_ID=             # unset → Google login disabled (use dev-login)
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:3000
# LLM_MODEL=openai/gpt-5.4-mini
# LLM_VISION_MODEL=             # unset → same as LLM_MODEL; must see images
# OPENAI_API_KEY=

# Screenshot proofs — Cloudflare R2 (S3-compatible). All four unset → the
# upload control is hidden and proofs stay text-only; nothing else changes.
# Token needs "Object Read & Write" scoped to the one bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=masterji-proofs
# R2_ENDPOINT=                  # unset → https://<account-id>.r2.cloudflarestorage.com
# OTEL_EXPORTER_OTLP_ENDPOINT=  # unset → tracing off
# OTEL_EXPORTER_OTLP_API_KEY=
