# --- frontend (.env.local) --------------------------------------------------
# Server-side proxy target for /api/* rewrites. Local Django default:
API_URL=http://127.0.0.1:8000

# --- backend (backend/.env) -------------------------------------------------
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=            # required when DJANGO_DEBUG=0
# DATABASE_URL=                 # commented out → local SQLite. Set but blank is
#                               # refused, so DATABASE_URL="$VAR" with VAR unset
#                               # stops the boot instead of opening SQLite.
# GOOGLE_CLIENT_ID=             # unset → Google login disabled (use dev-login)
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:3000
# LLM_MODEL=openai/gpt-5.4-mini
# LLM_JUDGE_MODEL=openai/gpt-5.4   # unset → same as LLM_MODEL. The two calls
#                               # that reach a verdict (evening accept/push_back,
#                               # morning on_phase + proof_ask). Worth a
#                               # stronger tier than the chat: a wrong verdict
#                               # either banks a proof that isn't there or sends
#                               # a builder who did the work away to rewrite it.
#                               # The example is the non-mini sibling of the
#                               # LLM_MODEL default ON PURPOSE — same provider,
#                               # so the OPENAI_API_KEY above is the only key
#                               # needed. ~3x per token on these two calls and
#                               # nothing else; the chat carries the volume and
#                               # stays on the cheap model. Must be
#                               # vision-capable, since LLM_VISION_MODEL falls
#                               # back to whatever this names.
# LLM_VISION_MODEL=             # unset → same as LLM_JUDGE_MODEL; must see
#                               # images. Only the evening's verdict sends one.
# OPENAI_API_KEY=

# Screenshot proofs — Cloudflare R2 (S3-compatible). All four unset → the
# upload control is hidden and proofs stay text-only; nothing else changes.
# Token needs "Object Read & Write" scoped to the one bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=masterji-proofs
# R2_ENDPOINT=                  # unset → https://<account-id>.r2.cloudflarestorage.com
# OTEL_EXPORTER_OTLP_ENDPOINT=  # unset → tracing off
# OTEL_EXPORTER_OTLP_API_KEY=
